{
  "name": "@bryan-cmf/dsh-insights",
  "description": "DSH-Plugin: value-oriented observation & insight pipeline — four views (觀測/記憶/洞察/筆記) + two agents (觀測智能體 rolling chronicle & milestones; 洞察智能體 deep-thinking direction advisor with floating chat). Merged from dsh-infra-observability, dsh-vector-memory, dsh-view-perspectives, dsh-insight-agent.",
  "version": "0.5.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "observability",
    "memory",
    "insights",
    "notes",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "types": "tsc -p tsconfig.json",
    "bundle": "tsdown",
    "build": "pnpm clean && pnpm types && pnpm bundle",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsdown": "^0.22.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "@types/react": "^18.3.1",
    "zod": "^4.4.3"
  }
}
